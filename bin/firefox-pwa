#!/usr/bin/env bash
# firefox-pwa — launch Firefox in PWA-like mode with optional window rules
# Usage: firefox-pwa <url> [rules...]
#   rules: hyprctl set_prop key=value pairs (space-separated)
#   e.g. firefox-pwa https://example.com float=1
#   e.g. firefox-pwa https://example.com opacity="0.9 override"
#   default: fullscreenstate 0 2 (PWA mode)

URL="$1"
shift

if [[ -z "$URL" ]]; then
    echo "Usage: firefox-pwa <url> [rules...]"
    exit 1
fi

# X11/dwm: fake-fullscreen the new Firefox window instead of using Hyprland state
if [[ "${XDG_CURRENT_DESKTOP:-}" != "Hyprland" && -n "${DISPLAY:-}" ]]; then
    before="$(xdotool search --class firefox 2>/dev/null | sort || true)"
    setsid firefox --new-window "$URL" >/dev/null 2>&1 &

    for _ in $(seq 1 100); do
        after="$(xdotool search --onlyvisible --class firefox 2>/dev/null | sort || true)"
        new=""
        bestarea=0
        for id in $(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after")); do
            WIDTH=0
            HEIGHT=0
            eval "$(xdotool getwindowgeometry --shell "$id" 2>/dev/null)" || continue
            # Firefox exposes 1x1 helpers and small transients; pick the real window
            area=$(( ${WIDTH:-0} * ${HEIGHT:-0} ))
            if [[ "$area" -gt 200000 && "$area" -gt "$bestarea" ]]; then
                new="$id"
                bestarea="$area"
            fi
        done
        if [[ -n "$new" ]]; then
            sleep 0.3
            xdotool windowactivate --sync "$new" 2>/dev/null || xdotool windowfocus --sync "$new" 2>/dev/null || true
            # Firefox may still be initializing and drop an early state change
            sleep 2
            for _ in $(seq 1 20); do
                xprop -id "$new" -f _NET_WM_STATE 32a -set _NET_WM_STATE _NET_WM_STATE_FULLSCREEN 2>/dev/null || true
                if xprop -id "$new" _NET_WM_STATE 2>/dev/null | grep -q _NET_WM_STATE_FULLSCREEN; then
                    exit 0
                fi
                sleep 0.1
            done
            exit 1
        fi
        sleep 0.1
    done
    echo "Timeout waiting for Firefox window"
    exit 1
fi

# Default: PWA fullscreen
if [[ $# -eq 0 ]]; then
    RULES="fullscreenstate 0 2"
else
    RULES="$*"
fi

# Get current Firefox window addresses
before=$(hyprctl clients -j | jq -r '[.[] | select(.class == "firefox") | .address] | sort | join("\n")')

# Launch Firefox
setsid firefox --new-window "$URL" &

# Wait for new window to appear (max 10 seconds)
for i in {1..100}; do
    after=$(hyprctl clients -j | jq -r '[.[] | select(.class == "firefox") | .address] | sort | join("\n")')
    
    new_addr=$(comm -13 <(echo "$before") <(echo "$after") | head -1)
    
    if [[ -n "$new_addr" ]]; then
        sleep 0.3
        hyprctl eval "hl.dispatch(hl.dsp.focus({ window = hl.get_window('address:$new_addr') }))"
        
        # Apply rules
        if [[ "$RULES" == fullscreenstate\ * ]]; then
            internal=$(echo "$RULES" | awk '{print $2}')
            client=$(echo "$RULES" | awk '{print $3}')
            hyprctl eval "hl.dispatch(hl.dsp.window.fullscreen_state({ internal = $internal, client = $client, window = hl.get_window('address:$new_addr') }))"
        else
            for rule in $RULES; do
                key="${rule%%=*}"
                val="${rule#*=}"
                hyprctl eval "hl.dispatch(hl.dsp.window.set_prop({ prop = '$key', value = '$val', window = hl.get_window('address:$new_addr') }))"
            done
        fi
        
        exit 0
    fi
    sleep 0.1
done

echo "Timeout waiting for Firefox window"
exit 1
